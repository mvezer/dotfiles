#!/usr/bin/env bash

set -e

# dependencies: must have fzf and awk installed
# the project file is should be written in the following format:
# project name  /path/to/projec
# so it's title and path separated by double space

PROJECTS_FILE=$HOME/.projects

if [[ ! -z "$1" ]]; then
  echo "Usage: p [add|edit]"
  echo "$1"
  if [[ "$1" == "add" ]]; then
    read -p "Enter project name: " project_name
    if [[ -z "$project_name" ]]; then
      exit 0
    fi
    echo "$project_name  $PWD" >> $PROJECTS_FILE
  elif [[ "$1" == "edit" ]]; then
    $EDITOR $PROJECTS_FILE
  fi
  exit 0
fi

if [[ ! -f $PROJECTS_FILE ]]; then
  echo "No projects file found at $PROJECTS_FILE"
  exit 1
fi


SELECTED=$(cat $PROJECTS_FILE | fzf --delimiter '  ' --with-nth=1)

if [[ -z "$SELECTED" ]]; then
  exit 0
fi

TARGET_DIR=$(echo "$SELECTED" | awk -F'  ' '{print $2}')
PROJECT_NAME=$(echo "$SELECTED" | awk -F'  ' '{print $1}')
if [[ ! -z $TARGET_DIR ]]; then
  cd $TARGET_DIR
  if [[ ! -z $PROJECT_NAME ]]; then
    tmux rename-session $PROJECT_NAME
  fi
fi

